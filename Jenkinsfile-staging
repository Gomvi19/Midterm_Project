pipeline {
    agent any

    stages {
        stage('Build & Test') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t discount-calculator .'
            }
        }

        stage('Deploy to Staging') {
            steps {
                bat 'docker rm -f discount-staging || true'
                bat 'docker run -d --name discount-staging discount-calculator'
                bat 'docker run -d --name discount-staging-2 discount-calculator'
                bat 'docker run -d --name discount-staging-3 discount-calculator'
            }
        }
    }
}